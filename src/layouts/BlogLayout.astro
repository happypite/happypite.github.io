---
import '../styles/blog.css';
import Icon from '../components/Icon.astro';
import { site, groups } from '../data/blog';
interface Props { title?: string; description?: string; heading?: string; eyebrow?: string; page?: string; }
const { title = '기록', description = site.description, heading = title, eyebrow = 'PERSONAL ARCHIVE', page = 'archive' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page === 'post' ? 'article' : 'website'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const saved = localStorage.getItem('happypite:theme');
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {}
        const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body id="top" data-page={page}>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="logo" href={base} aria-label="happypite 전체 기록">{site.name}<span>.</span></a>
        <nav class="header-nav" aria-label="주 메뉴">
          <a href={base} aria-current={page === 'archive' || page === 'post' ? 'page' : undefined}>기록</a>
          <a href={`${base}about/`} aria-current={page === 'about' ? 'page' : undefined}>소개</a>
          <span class="nav-divider" aria-hidden="true"></span>
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="색상 모드 변경" title="색상 모드 변경">
            <span data-theme-icon="system"><Icon name="system" /></span>
            <span data-theme-icon="light" hidden><Icon name="sun" /></span>
            <span data-theme-icon="dark" hidden><Icon name="moon" /></span>
          </button>
          <span id="theme-status" class="sr-only" role="status" aria-live="polite"></span>
        </nav>
      </header>
      <section class="archive-top" aria-label="페이지 제목">
        <div class="title-lockup"><span class="overline">{eyebrow}</span><h1 id="page-heading">{heading}</h1></div>
      </section>
      <slot name="categories" />
      <div class="content-columns">
        <main id="main"><slot /></main>
        <aside class="archive-aside" aria-label="기록의 갈피">
          <h2>기록의 갈피</h2>
          <nav class="shortcuts" aria-label="주제별 글 모음">
            {groups.map(group => <a href={`${base}?group=${group.id}`} data-group={group.id}>{group.label}<span aria-hidden="true">↗</span></a>)}
          </nav>
          <p class="signature">나만의 블로그</p>
        </aside>
      </div>
      <footer class="site-footer"><span>© {new Date().getFullYear()} Happypite</span><a href="#top" data-to-top>맨 위로 ↑</a></footer>
    </div>
    <script>import '../scripts/theme';</script>
  </body>
</html>
